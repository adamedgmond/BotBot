{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botbot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // Weekly guild reconcile. Nothing here is time-sensitive -- departures are
  // caught within a week and only acted on 30 days later.
  "triggers": { "crons": ["0 4 * * 1"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botbot",
      // Replace with the id printed by: wrangler d1 create botbot
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ]
  // Worker secrets (set via `wrangler secret put`, never committed):
  //   DISCORD_PUBLIC_KEY  - Developer Portal > General Information. Verifies
  //                         every incoming interaction signature.
  //   DISCORD_TOKEN       - Developer Portal > Bot. Required by the weekly
  //                         scheduled() reconcile; without it retention throws
  //                         a 401 every week and silently stops running.
  //
  // Local-only, for scripts/register.mjs (a .env or your shell, not a secret):
  //   DISCORD_TOKEN, DISCORD_APPLICATION_ID
}
