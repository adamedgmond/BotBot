{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botbot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // Weekly guild reconcile. Nothing here is time-sensitive -- departures are
  // caught within a week and only acted on 30 days later.
  "triggers": { "crons": ["0 4 * * 1"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botbot",
      // Replace with the id printed by: wrangler d1 create botbot
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set via `wrangler secret put`, never committed):
  //   DISCORD_PUBLIC_KEY      - Developer Portal > General Information
  //   DISCORD_TOKEN           - Developer Portal > Bot  (only needed by scripts/register.mjs)
  //   DISCORD_APPLICATION_ID  - Developer Portal > General Information
}
